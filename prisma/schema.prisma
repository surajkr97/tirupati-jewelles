// Data model — MASTER-SPEC §5.
// Created by Phase 1 (specs/01-cleanup-scaffold.md §1.6).
//
// Money is BigInt PAISE everywhere. Never Float, never Decimal for currency.
// Decimal is used only for percentages (makingPct, gstPct), where it is exact and small.
// See MASTER-SPEC §4.

generator client {
  provider = "prisma-client-js"
}

// Two connections, deliberately (Phase 9 §9.1, SEC-029).
//
// `url` is what the running application uses: the `tirupati_app` role, which can read and
// write rows and nothing else — no CREATE, no DROP, and no DELETE on "Order", "OrderItem"
// or "BillPdf", so the six-year GST invoice retention DEBT-026 requires is enforced by the
// database rather than by convention.
//
// `directUrl` is what `prisma migrate` uses: the owner role, which still has DDL. Changing
// the shape of the database is a rare, deliberate act; serving requests is constant and
// internet-facing. They should not share a set of privileges.
//
// Note that `prisma generate` resolves BOTH, so MIGRATE_DATABASE_URL must be present at
// build time as well as at migration time — `pnpm build` runs generate first.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── users & auth

model User {
  id            String   @id @default(uuid())
  phone         String?  @unique // E.164, +91XXXXXXXXXX
  email         String?  @unique
  passwordHash  String?
  name          String?
  phoneVerified Boolean  @default(false)
  emailVerified Boolean  @default(false)
  role          Role     @default(CUSTOMER)
  orders        Order[]
  createdAt     DateTime @default(now())

  @@index([phone])
}

enum Role {
  CUSTOMER
  ADMIN
}

model OtpCode {
  id         String    @id @default(uuid())
  identifier String // phone or email
  channel    Channel
  codeHash   String // hashed, never plaintext
  purpose    String // SIGNUP | LOGIN | CLAIM_ORDER
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

enum Channel {
  SMS
  EMAIL
}

/// Proof that someone holds a phone number, delivered TO that number.
/// Created by Phase 9 (DEBT-011), designed in the Phase 8 SECURITY review.
///
/// ═══════════════════════════════════════════════════════════════════════════
///  THIS IS THE POSSESSION PROOF THE ORDER CLAIM HAS BEEN WAITING FOR.
///
///  MASTER-SPEC §5: "The claim runs only after successful OTP verification of that exact
///  number. Never on an unverified phone field. This is the difference between a feature and
///  an account-takeover vector."
///
///  Email OTP proves control of an ACCOUNT, not of a NUMBER (D-011), so
///  `claimOrdersForVerifiedPhone` had no caller and Phase 8's flagship feature could not
///  complete. A token minted with the bill and sent inside the §8.4 WhatsApp message is
///  delivered to the number itself — the same thing an SMS OTP proves, over a channel the
///  shop already uses and pays nothing for.
///
///  Stored HASHED, exactly like `OtpCode`. A database leak must not hand out claim
///  capabilities, and the raw token exists only in the message that carried it.
/// ═══════════════════════════════════════════════════════════════════════════
model ClaimToken {
  id String @id @default(uuid())

  /// SHA-256 of the raw token, peppered with OTP_PEPPER. Never the token itself.
  tokenHash String @unique

  /// E.164. The number being proven — NOT the account, which does not exist yet.
  phone String

  /// The bill it was issued with. Audit only; claiming attaches every unclaimed order for
  /// the number, not just this one.
  orderId String?

  /// Single use. Set by a conditional UPDATE, never by a read-then-write.
  consumedAt DateTime?
  /// Which account consumed it, for the audit trail.
  consumedBy String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────── rates

model MetalRate {
  id          String   @id @default(uuid())
  metal       Metal
  purity      Purity
  ratePerGram BigInt // PAISE per gram
  effectiveAt DateTime @default(now())
  setByUserId String

  @@index([metal, purity, effectiveAt])
}

enum Metal {
  GOLD
  SILVER
}

enum Purity {
  K22_916
  K18_750
  SILVER_999
}

// ───────────────────────────────────────────────────────────────────── catalog

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  imageUrl    String?
  /// See ProductImage.blurDataUrl.
  blurDataUrl String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
}

model Product {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  metal       Metal
  purity      Purity
  weightMg    Int // milligrams
  makingPct   Decimal        @db.Decimal(5, 2)
  stoneCharge BigInt         @default(0) // paise
  hasHallmark Boolean        @default(true)
  hallmarkNo  String?
  bisCertNo   String?
  images      ProductImage[]
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  enquiries   Enquiry[]
  createdAt   DateTime       @default(now())

  @@index([categoryId, isActive])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  /// Phase 9 §9.2: "blur placeholders everywhere."
  ///
  /// A ~20-byte-wide JPEG, base64 in a data URI, generated once from the stored image and
  /// handed to `next/image` as `blurDataURL`. Stored rather than derived at render time
  /// because deriving it means fetching the full image on the server for every page render,
  /// which is the opposite of the optimisation.
  ///
  /// Nullable on purpose: an image without one still renders, it just fades in from the
  /// frame's flat tint. A missing placeholder must never be a broken page.
  blurDataUrl String?

  // Phase 9 §9.2. Postgres does NOT index a foreign key automatically, and Prisma does not
  // add one either — so this was a sequential scan per lookup. Every product card and every
  // gallery reads images by productId, and §6.2 renders them in sortOrder, so the composite
  // serves the filter and the ordering in one index.
  //
  // Invisible today: at 75 rows the planner correctly prefers a seq scan, which is exactly
  // why this was found by checking index coverage rather than by reading EXPLAIN output on
  // development data.
  @@index([productId, sortOrder])
}

model MediaSlot {
  id          String   @id @default(uuid())
  slotKey     String   @unique // HERO_BANNER | OFFER_STRIP | CATEGORY_TILE_1 ...
  imageUrl    String?
  /// See ProductImage.blurDataUrl.
  blurDataUrl String?
  linkUrl     String?
  headline    String?
  subtext     String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────── orders & bills

model Order {
  id              String      @id @default(uuid())
  orderNo         String      @unique // JW-2026-0001
  userId          String? // null until claimed
  user            User?       @relation(fields: [userId], references: [id])
  customerPhone   String // E.164 — the claim key
  customerName    String?
  items           OrderItem[]
  subtotal        BigInt
  gstAmount       BigInt
  grandTotal      BigInt
  billPdfKey      String? // UUID path segment, unguessable
  sentViaWa       Boolean     @default(false)
  sentAt          DateTime?
  createdByUserId String
  createdAt       DateTime    @default(now())

  // ── Phase 8 (specs/08-billing-whatsapp.md) ────────────────────────────────

  /// §8.1: "optional note". Free text from the admin; escaped everywhere it renders.
  note String?

  /// §8.3: the rate reference block — "Rates applied on <date>: Gold 22K ₹X/10g …".
  ///
  /// Every purity's rate at bill time, paise per gram as strings, not only the ones on the
  /// bill. `OrderItem.ratePerGram` already snapshots what was *applied*; this snapshots
  /// what was *quoted*, which is what makes the invoice defensible months later.
  ratesSnapshot Json?
  ratesAt       DateTime?

  /// §8.2: "a repeated key returns the existing order rather than creating a duplicate."
  /// Unique, so the guarantee is the database's rather than a read-then-write race.
  idempotencyKey String? @unique

  /// §8.5: "void (soft — never hard delete an invoice)". A voided invoice still exists,
  /// still has its number, and is excluded from every total (§8.7).
  voidedAt       DateTime?
  voidReason     String?
  voidedByUserId String?

  billPdf BillPdf?

  @@index([customerPhone])
  @@index([userId])
  /// §8.5's list is ordered newest-first and filtered by date range.
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  name        String
  metal       Metal
  purity      Purity
  weightMg    Int
  ratePerGram BigInt // SNAPSHOT at bill time — never recompute a historical bill
  makingPct   Decimal @db.Decimal(5, 2)
  stoneCharge BigInt  @default(0)
  gstPct      Decimal @db.Decimal(5, 2)
  lineTotal   BigInt

  /// §8.3: "Hallmark / HUID / BIS numbers per item where present."
  ///
  /// Snapshotted like the rate, for the same reason: a product's hallmark number can be
  /// corrected in the catalogue, and reprinting a 2026 invoice must not silently restate
  /// which physical piece was sold.
  hallmarkNo String?
  bisCertNo  String?

  // Phase 9 §9.2, same reason as ProductImage: an unindexed foreign key. Every bill screen,
  // every PDF render and every /account/orders row reads items by orderId, and invoices are
  // retained for six years (DEBT-026) — so this is the one table guaranteed to keep growing
  // and never be pruned.
  @@index([orderId])
}

/// Per-year invoice sequence (Phase 8 §8.2).
///
/// §8.2: "sequence from a DB counter inside the transaction. **Do not derive it from
/// `COUNT(*)`** — concurrent bills will collide."
///
/// One row per year, because the number resets: `JW-2026-0001` then `JW-2027-0001`. The
/// increment is a single `INSERT … ON CONFLICT DO UPDATE … RETURNING`, which takes a row
/// lock for the rest of the transaction — so fifty concurrent bills serialise on this row
/// and each gets its own number. See lib/bills/numbering.ts.
model BillSequence {
  year Int @id
  /// The NEXT number to hand out. Read-modify-write happens in one statement.
  next Int @default(1)
}

/// The rendered invoice (Phase 8 §8.3).
///
/// Bytes live in Postgres rather than an object store — see DECISIONS.md D-026. The short
/// version: there is no private bucket configured, Cloudinary is image-scoped, and a bill
/// that has never been stored anywhere provable is worse than one stored in the database
/// that already holds the order it belongs to.
model BillPdf {
  /// §8.3: "Key: `bills/{uuidv4}.pdf` — never sequential, never guessable."
  key       String   @id
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bytes     Bytes
  byteSize  Int
  createdAt DateTime @default(now())
  /// §8.3: signed URLs expire. Kept on the row so the link's lifetime is a property of the
  /// bill rather than of whoever last minted a URL for it.
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────── audit

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String // RATE_SET | ORDER_CREATE | BILL_SEND | PRODUCT_EDIT
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ──────────────────────────────────────────────────────────────────── calculator

/// Shareable calculator result (Phase 5 §5.5).
///
/// Not in MASTER-SPEC §5's data model — see DECISIONS.md D-015 for why this lives in
/// Postgres rather than Redis. The short version: §5.5 promises a link that still works in
/// 30 days and still shows the same price, and a cache is the wrong home for a durable
/// promise.
model CalculatorShare {
  id   String @id @default(uuid())
  /// Short, unguessable path segment. Same reasoning as a bill PDF key: the URL is the
  /// only thing guarding it, so it must not be enumerable.
  slug String @unique

  /// The item set exactly as submitted, re-validated on read.
  items Json

  /// Rates SNAPSHOTTED at share time, paise per gram by purity. §5.5: "recomputes with
  /// rates snapshotted at share time, so a shared link doesn't silently change price."
  /// Same principle as OrderItem.ratePerGram — a quote must not move under the recipient.
  rates Json

  /// Shown on the page so the recipient knows how old the quote is.
  ratesAt   DateTime
  createdAt DateTime @default(now())
  /// 30 days from creation (§5.5).
  expiresAt DateTime

  /// Phase 9 will sweep expired rows; the index makes that cheap.
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────── enquiries

/// A WhatsApp enquiry, logged for the Phase 7 admin dashboard (Phase 6 §6.3).
///
/// Not in MASTER-SPEC §5 — see DECISIONS.md D-017. `AuditLog` was the alternative and is
/// the wrong shape: its `actorId` is non-null and means "the admin who did this", whereas
/// almost every enquiry is anonymous. Overloading it would make the audit trail unusable
/// for the thing it exists for.
///
/// Deliberately thin. §6.3 logs "product, timestamp, session" and nothing else; an enquiry
/// is a signal that someone was interested, not a record about a person.
model Enquiry {
  id        String   @id @default(uuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Opaque session id when the visitor has one. Never a phone number or a name — the
  /// message goes to WhatsApp, and we do not have those details at this point anyway.
  sessionId String?
  /// `PRODUCT` or `FLOATING` — which surface the enquiry came from.
  source    String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────── settings

/// Shop settings (Phase 7 §7.9).
///
/// Not in MASTER-SPEC §5 — see DECISIONS.md D-022. A single row, keyed on a constant, so
/// there is no "which settings row is live?" question and no way to end up with two.
model Settings {
  /// Always `singleton`. A check constraint in spirit: one row, forever.
  id String @id @default("singleton")

  shopName      String  @default("Tirupati Jewelles")
  address       String?
  gstin         String?
  contactPhone  String? @map("contact_phone")
  ownerWhatsApp String? @map("owner_whatsapp")

  /// Defaults for the calculator and new products. MASTER-SPEC §4 puts GST at 3.
  defaultGstPct    Decimal @default(3.00) @db.Decimal(5, 2)
  defaultMakingPct Decimal @default(12.00) @db.Decimal(5, 2)

  /// Phase 8 bill numbering — `JW-2026-0001`.
  billPrefix   String @default("JW")
  billSequence Int    @default(1)

  /// §7.9: "Ticker jitter on/off — surface the env flag in the UI so the owner can disable
  /// it without a deploy." Null means "follow NEXT_PUBLIC_TICKER_JITTER"; a boolean
  /// overrides it. MASTER-SPEC §8 calls the off-switch the legal insurance.
  tickerJitter Boolean?

  businessHours String?
  holidayNotice String?

  updatedAt DateTime @updatedAt
}
