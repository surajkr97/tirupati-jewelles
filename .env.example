# Copy to .env and fill in.  cp .env.example .env
#
# lib/env.ts parses this with Zod at boot and THROWS on anything missing or malformed.
# Every CHANGE_ME below is rejected in production (NODE_ENV=production) but tolerated in
# development so the stack boots on a fresh clone.
#
# Schema: specs/00-MASTER-SPEC.md §9.  Never commit the filled-in .env.

# ─── Database ────────────────────────────────────────────────────────────────
# Local (host) — matches the docker-compose credentials below.
# Inside compose the app overrides the host to `db`.
DATABASE_URL=postgresql://tirupati:CHANGE_ME_DB_PASSWORD@localhost:5432/tirupati

# Consumed by the `db` service in docker-compose.yml. Keep in step with DATABASE_URL.
POSTGRES_USER=tirupati
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=tirupati

# ─── Redis ───────────────────────────────────────────────────────────────────
# Cache, sessions, rate limiting, OTP storage — and the Celery broker.
# Password-protected per specs/09-hardening.md §9.1; not published to the host.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Secrets — 32+ bytes each ────────────────────────────────────────────────
# Generate real values with:  openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_bytes_long
OTP_PEPPER=CHANGE_ME_otp_pepper_at_least_32_bytes_long_xx

# ─── Notifications (wired up in Phase 3) ─────────────────────────────────────
# In development the OTP is logged to the console instead of sent, so placeholders are
# fine until you actually want delivery.
SMS_PROVIDER_KEY=CHANGE_ME_msg91_or_twilio_key
SMTP_URL=smtp://user:CHANGE_ME@localhost:1025

# ─── Uploads and images (Phase 7) ────────────────────────────────────────────
UPLOAD_PROVIDER_KEY=CHANGE_ME_uploadthing_or_cloudinary_key
# Default-deny allowlist for the admin image-URL field. This is an SSRF control
# (specs/07-admin-panel.md §7.7) — only add hosts you actually serve images from.
ALLOWED_IMAGE_HOSTS=res.cloudinary.com,utfs.io

# ─── Seed admin (Phase 1 §1.6 — credentials from env, never hardcoded) ───────
SEED_ADMIN_EMAIL=admin@tirupatijewelles.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ─── Client-visible (inlined into the browser bundle — never put secrets here) ─
# Owner's WhatsApp number, digits only, country code first.
NEXT_PUBLIC_OWNER_WA=919876543210
# The rate-ticker jitter off-switch (specs/00-MASTER-SPEC.md §8). Must keep working:
# it is the mitigation if a customer ever disputes a displayed price.
NEXT_PUBLIC_TICKER_JITTER=true
