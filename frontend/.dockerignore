# Host node_modules holds darwin-compiled binaries that would break in a Linux
# container — the image installs its own.
node_modules
.next
out

.git
.gitignore

# Keeps host URLs out of the built image. Note the dev compose bind-mounts the
# source, which puts .env.local back inside the container — harmless, because
# Next does not let a .env file override a variable already in the environment,
# and compose sets those explicitly.
.env*.local

npm-debug.log*
.DS_Store
