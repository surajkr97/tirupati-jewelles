# Postgres — inside docker compose this is overridden to point at the `db` service
DATABASE_URL=postgresql://fastapi_user:fastapi123@localhost:5432/tirupati_db

# Redis — used both as the live-rate cache and as the Celery broker
REDIS_URL=redis://localhost:6379/0

# Signs access tokens — server-side only, never share
SECRET_KEY=change-me

# Guards POST /rates/internal/refresh (sent as the X-Refresh-Key header).
# This one gets handed out to whatever calls that endpoint.
REFRESH_SECRET_KEY=change-me-too

# Signs refresh tokens — server-side only, never share.
# Must be a different value from REFRESH_SECRET_KEY: anything that knows the
# signing key can forge a refresh token for any user.
REFRESH_TOKEN_SECRET=change-me-as-well

# Auth cookie. Defaults below suit local dev, where :3000 and :8000 count as the
# same site (the port is not part of a cookie's "site"), so lax over http works.
# In production the frontend and API are on different domains, which makes the
# cookie cross-site — there you must set:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true      (samesite=none is rejected by browsers without it)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Only set this if the API and frontend share a parent domain, e.g. serving the
# API from api.tirupatijewelles.com — then COOKIE_DOMAIN=.tirupatijewelles.com
# keeps the cookie same-site and avoids samesite=none entirely.
# COOKIE_DOMAIN=
