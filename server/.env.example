# Postgres — inside docker compose this is overridden to point at the `db` service
DATABASE_URL=postgresql://fastapi_user:fastapi123@localhost:5432/tirupati_db

# Redis — used both as the live-rate cache and as the Celery broker
REDIS_URL=redis://localhost:6379/0

# Signing secret
SECRET_KEY=change-me

# Guards POST /rates/internal/refresh (sent as the X-Refresh-Key header)
REFRESH_SECRET_KEY=change-me-too
